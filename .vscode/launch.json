{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "3000", "HOST": "127.0.0.1" },
      "preLaunchTask": "Prepare app",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "listening on (https?://\\S+)",
        "uriFormat": "%s"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Run app (pull latest)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "3000", "HOST": "127.0.0.1" },
      "preLaunchTask": "Prepare app (pull latest)",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "listening on (https?://\\S+)",
        "uriFormat": "%s"
      },
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
